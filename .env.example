# =============================================================
# CivicPulse AI — environment variables (example)
# Copy to .env and fill in real values. Never commit the real .env.
#
# Local dev layout:
#   - backend:  cp .env.example backend/.env   (or keep .env at repo root)
#   - dashboard: reads VITE_* vars from repo root via vite.config.ts envDir
# =============================================================

# --- App ---
ENV=development
APP_NAME=CivicPulse AI
API_V1_PREFIX=/api/v1
SECRET_KEY=changeme-generate-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# --- Local dev admin seed (single-admin MVP) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg2://civicpulse:civicpulse@localhost:5432/civicpulse

# --- Redis (WhatsApp in-progress report sessions, caching, queues) ---
REDIS_URL=redis://localhost:6379/0
WHATSAPP_SESSION_TTL_SECONDS=1800

# --- Meta WhatsApp Cloud API ---
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v23.0

# --- AWS S3 (photo & voice note storage) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=civicpulse-media-dev

# --- Whisper (speech-to-text, multilingual incl. Arabic dialects) ---
# Production CPU MVP: use small. Run prepare_whisper BEFORE starting the API.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE_HINT=auto
WHISPER_PRELOAD=false
WHISPER_LOCAL_FILES_ONLY=false
WHISPER_MAX_CONCURRENT=1
WHISPER_ALLOW_CPU_FALLBACK=false

# --- Hugging Face / Transformers (classification + embeddings) ---
HF_HOME=.cache/huggingface
HF_TOKEN=
HF_CLASSIFICATION_MODEL=
HF_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Maps (Google Maps API / Mapbox) ---
MAPS_PROVIDER=mapbox
MAPS_API_KEY=

# --- Dashboard (Vite/React) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MAPS_API_KEY=
